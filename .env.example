# REFERENCE ONLY - DO NOT copy to .env
# This project uses Doppler for configuration management.
# These values should be configured in Doppler, not in .env files.
# See README.md for setup instructions.
#
# Hetchy is multi-tenant: per-org settings (GitHub App installations,
# Slack bot/socket tokens, Anthropic API key, optional SX key, default
# repo selection) live in the database under the WorkOS organization_id.
# Users configure those at /settings/org?tab=integrations after signing
# up. The variables below are *process-level* config only.

# --- WorkOS (user/organization management) -------------------------------
# Sign in to https://dashboard.workos.com, copy from the Staging environment
# during dev. Add http://dev.hetchy.ai:8080/callback to "Redirects" in the
# dashboard before logging in for the first time. (See README for the
# /etc/hosts entry that points dev.hetchy.ai at 127.0.0.1.)
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_test_...
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=replace-with-32-bytes-of-randomness
# Must match a redirect URI registered in the WorkOS dashboard.
WORKOS_REDIRECT_URI=http://dev.hetchy.ai:8080/callback
# Where the browser lands after WorkOS-side logout completes.
LOGOUT_RETURN_TO=http://dev.hetchy.ai:8080/

# --- GitHub App ----------------------------------------------------------
# One App per env (dev/staging/prod), created on the hetchyhq GitHub org.
# Per-org installation tokens are minted at request time; nothing
# org-specific lives here. See README's "Per-env GitHub App setup" for
# how to create the App and generate the private key.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=hetchy-dev
# Captured for completeness; only used if user-OAuth is added later.
GITHUB_APP_CLIENT_ID=Iv1.deadbeef
# Multi-line PEM contents of the App's private key. In Doppler, paste
# the whole file. In a .env file: GITHUB_APP_PRIVATE_KEY="$(cat key.pem)".
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# Generate with: openssl rand -hex 32. Must match the secret configured
# on the GitHub App's webhook page.
GITHUB_APP_WEBHOOK_SECRET=replace-with-hex-secret

# --- Slack OAuth (optional, for /settings/org Slack install flow) --------
# Only needed if you want orgs to install Slack via OAuth in the UI.
# Dev mode (HETCHY_ENV=dev) also supports manual bot/socket token paste.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://dev.hetchy.ai:8080/integrations/slack/callback

# --- Secret encryption ---------------------------------------------------
# Used to encrypt per-org GH/Slack tokens at rest. 32 bytes; raw, hex, or
# base64 are all accepted. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-with-32-bytes-of-randomness

# --- Daytona -------------------------------------------------------------
# Local OSS stack (after `make daytona-up` and creating an API key in the
# dashboard at http://localhost:3000):
DAYTONA_API_URL=http://localhost:3000/api
DAYTONA_API_KEY=dtn_...

# Hosted (Daytona Cloud) — swap the two values above for these:
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_API_KEY=dtn_...

# Snapshot to spawn from. Build and push a local one with `make push-snapshot`.
DAYTONA_SNAPSHOT=claude-playwright:1

# --- SX assets -----------------------------------------------------------
# Public git sx vault with Hetchy's built-in agent personas and scoped role
# skills. This defaults to the official Hetchy vault when unset; override it
# to test a fork.
# Per-org skills.new SX keys are configured in /settings/org and installed
# separately inside each sandbox.
HETCHY_SX_PUBLIC_VAULT_URL=https://github.com/hetchyhq/hetchy-sx-vault.git

# --- Database (Postgres / Supabase) --------------------------------------
# Local dev: docker-compose ships a postgres:16 container.
#   make pg-up  starts it on host port 5433 (override via POSTGRES_HOST_PORT).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hetchy?sslmode=disable
#
# Cloud (Supabase) — three connection modes from Project Settings → Database:
#   - Direct (port 5432):           full Postgres, prepared statements OK.
#                                   Use this for migrations.
#   - Session pooler (5432, *-pooler.supabase.com):
#                                   prepared statements OK.
#   - Transaction pooler (6543):    serverless-friendly, prepared statements
#                                   NOT supported — append
#                                   `?default_query_exec_mode=exec` for pgx.
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require

# --- Web UI --------------------------------------------------------------
# Port the local chat UI listens on (http://dev.hetchy.ai:$WEB_PORT).
# Default is 8080 — avoid 3000, which the local Daytona dashboard uses.
WEB_PORT=8080
# Set to 1 only when serving over plain HTTP (local dev). In production
# (TLS terminator in front of hetchy), leave empty so session cookies
# require Secure. The `make bot` target sets this for you.
COOKIE_INSECURE=
# Runtime mode — gates dev-only UI affordances (manual Slack token
# paste in Integrations). Defaults to prod.
HETCHY_ENV=prod

# --- Auth bypass (TESTS / CI ONLY) ---------------------------------------
# Setting AUTH_BYPASS=1 short-circuits WorkOS so go test / CI don't need
# real WorkOS credentials. Never enable in production.
# AUTH_BYPASS=1
# AUTH_BYPASS_USER=user_test
# AUTH_BYPASS_ORG=org_test
# AUTH_BYPASS_ROLE=admin
# AUTH_BYPASS_EMAIL=test@hetchy.local
