# Hetchy self-host environment
#
# Quick start:
#   cp .env.example .env
#   # edit DAYTONA_API_KEY and SECRETS_ENCRYPTION_KEY
#   docker compose up --build
#
# Per-organization integrations such as GitHub PATs, Anthropic/OpenAI
# credentials, Slack tokens, Linear workspaces, and default repositories are
# configured in the Hetchy UI after signup. This file is process-level config.

# --- Runtime --------------------------------------------------------------
HETCHY_ENV=prod

# Host port the web UI is published on. Change this to avoid a clash with
# something already on 8080; the container always listens on 8080 internally.
WEB_PORT=8080

# Container image Compose runs. The default builds from this checkout and tags
# it :dev. To run a published release instead of building, set a release tag
# here and start with `docker compose up -d --pull always`:
#
#   HETCHY_VERSION=v0.1.0
#
# See https://github.com/sleuth-io/hetchy/releases for available tags.
HETCHY_VERSION=dev
# HETCHY_IMAGE=ghcr.io/sleuth-io/hetchy
# HETCHY_PULL_POLICY=build
# For local UI testing, localhost is fine. For Daytona proof artifact uploads
# with HETCHY_ARTIFACT_DIR, this must be a public origin reachable from the
# sandbox. Use S3 artifact storage instead for private/local-only instances.
HETCHY_PUBLIC_BASE_URL=http://localhost:8080

# Use local username/password auth for self-hosting. WorkOS remains available
# for hosted deployments by setting HETCHY_AUTH_MODE=workos and filling the
# WorkOS section below.
HETCHY_AUTH_MODE=local

# Set only when running behind a reverse proxy that overwrites
# X-Forwarded-For/X-Real-IP. This lets local-auth rate limiting use the real
# client IP instead of the proxy IP.
HETCHY_TRUSTED_PROXY=false

# Set to 1 only when serving over plain HTTP. The default quick start uses
# http://localhost:8080, so this is enabled here. Behind HTTPS, set it empty.
COOKIE_INSECURE=1

# --- Database -------------------------------------------------------------
# docker-compose.yml includes a postgres service with these credentials.
POSTGRES_HOST_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hetchy
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/hetchy?sslmode=disable

# Optional pgx pool ceiling. Empty leaves pgx's default.
DATABASE_MAX_CONNS=

# --- Secret encryption ----------------------------------------------------
# Required. Used to encrypt per-org GitHub/Slack/Linear/AI tokens at rest.
# Generate with:
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-with-32-bytes-of-randomness

# --- Daytona --------------------------------------------------------------
# Required for v1. Hetchy runs agents inside Daytona sandboxes.
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_API_KEY=dtn_replace_me

# Snapshot base name. The app resolves this to DAYTONA_SNAPSHOT plus the
# build-time sandbox content version. See docs/daytona-setup.md.
DAYTONA_SNAPSHOT=universal-coding
DAYTONA_AUTO_ARCHIVE_MINUTES=60

# Optional dependency-cache controls.
DAYTONA_CACHE_VOLUMES_DISABLED=
DAYTONA_CACHE_VOLUME_PREFIX=
DAYTONA_CACHE_PRUNE_DAYS=
HETCHY_SX_CACHE_DIR=
HETCHY_SX_CACHE_MIN_FREE_MB=512
HETCHY_SX_GIT_OPERATION_TIMEOUT_SECONDS=180
HETCHY_SX_GIT_MAX_CONCURRENT_OPS=4

# --- Scheduled jobs -------------------------------------------------------
# The main process dispatches due jobs. Leave empty for defaults; set interval
# to 0 only if another scheduler runs `hetchy --dispatch-due-jobs`.
HETCHY_JOB_DISPATCH_INTERVAL_SECONDS=
HETCHY_JOB_DISPATCH_LIMIT=
HETCHY_JOB_DISPATCH_CONCURRENCY=

# PAT-connected repos do not receive GitHub App webhooks. The main process
# periodically refreshes stale open/unknown PR state for PAT-backed repos.
# Leave empty for defaults; set interval to 0 to disable.
HETCHY_PR_STATE_POLL_INTERVAL_SECONDS=
HETCHY_PR_STATE_POLL_LIMIT=

# --- Mid-turn resume ------------------------------------------------------
# An active run periodically snapshots its working tree to a compressed archive
# on the shared Daytona cache volume (alongside the repo checkout and dependency
# caches). That volume outlives the sandbox and is re-mounted into a replacement
# sandbox, so if the run's sandbox is lost mid-turn, recovery rebuilds a fresh
# sandbox, restores the snapshot, and continues instead of failing the run.
#
# Reconstruct-and-resume recovery is always on. Without a snapshot to restore it
# degrades to a from-scratch re-run.
#
# HETCHY_CHECKPOINT_INTERVAL_SECONDS: seconds between snapshots. Empty takes the
#   default of 30; 0 disables checkpointing. Only active when the cache volume
#   is mounted for the run (needs org/repo identity and cache volumes enabled);
#   snapshots never leave the sandbox/volume, so no repo CI is triggered. The
#   snapshot is deleted when the run completes normally.
HETCHY_CHECKPOINT_INTERVAL_SECONDS=

# --- GitHub App (optional) ------------------------------------------------
# Self-hosters can use a per-org GitHub personal access token in the UI with no
# process-level GitHub App config. Configure these only if you want webhook-
# driven repo/install sync via your own GitHub App.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# --- WorkOS auth (optional hosted mode) ----------------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=
WORKOS_WEBHOOK_SECRET=
LOGOUT_RETURN_TO=

# --- Slack OAuth (optional) ----------------------------------------------
# Manual per-org Slack token paste is available in dev mode. For OAuth install
# flow, configure these process-level app credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_REDIRECT_URI=

# --- Linear OAuth (optional) ---------------------------------------------
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_OAUTH_REDIRECT_URI=

# --- Stripe billing (optional hosted/commercial mode) --------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_IDS=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_TOPUP_PRICE_IDS=
STRIPE_TOPUP_PRICE_ID=
STRIPE_RETURN_TO=

# --- Proof artifacts (optional) ------------------------------------------
# Local filesystem storage is the default self-host path. Compose mounts a
# named volume here so validation screenshots/recordings can be linked from PRs.
# Because uploads are served by the Hetchy web process, Daytona sandboxes must
# be able to reach HETCHY_PUBLIC_BASE_URL. Clear this value and configure S3
# below when Hetchy is not publicly reachable.
HETCHY_ARTIFACT_DIR=/data/hetchy/artifacts

# Alternative AWS S3 path. Clear HETCHY_ARTIFACT_DIR before using S3.
HETCHY_S3_BUCKET=
HETCHY_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- SX / skills vault (optional) ----------------------------------------
# Defaults to Hetchy's public sx vault when empty. Set to disabled/off/none/-
# to skip the built-in public persona/skill vault install.
HETCHY_SX_PUBLIC_VAULT_URL=

# --- Auth bypass (tests/CI only) -----------------------------------------
# Never enable in production.
# AUTH_BYPASS=1
# AUTH_BYPASS_USER=user_test
# AUTH_BYPASS_ORG=org_test
# AUTH_BYPASS_ROLE=admin
# AUTH_BYPASS_EMAIL=test@hetchy.local
