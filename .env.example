# REFERENCE ONLY - DO NOT copy to .env
# This project uses Doppler for configuration management.
# These values should be configured in Doppler, not in .env files.
# See README.md for setup instructions.
#
# Hetchy is multi-tenant: per-org settings (GitHub repo + token, Slack
# bot/socket tokens, base branch, Anthropic API key, optional SX key)
# live in the database under the WorkOS organization_id. Users configure
# those at /settings/org after signing up. The variables below are
# *process-level* config only.

# --- WorkOS (user/organization management) -------------------------------
# Sign in to https://dashboard.workos.com, copy from the Staging environment
# during dev. Add http://localhost:8080/callback to "Redirects" in the
# dashboard before logging in for the first time.
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_test_...
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=replace-with-32-bytes-of-randomness
# Must match a redirect URI registered in the WorkOS dashboard.
WORKOS_REDIRECT_URI=http://localhost:8080/callback
# Where the browser lands after WorkOS-side logout completes.
LOGOUT_RETURN_TO=http://localhost:8080/

# --- Secret encryption ---------------------------------------------------
# Used to encrypt per-org GH/Slack tokens at rest. 32 bytes; raw, hex, or
# base64 are all accepted. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-with-32-bytes-of-randomness

# --- Daytona -------------------------------------------------------------
# Local OSS stack (after `make daytona-up` and creating an API key in the
# dashboard at http://localhost:3000):
DAYTONA_API_URL=http://localhost:3000/api
DAYTONA_API_KEY=dtn_...

# Hosted (Daytona Cloud) — swap the two values above for these:
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_API_KEY=dtn_...

# Snapshot to spawn from. Build and push a local one with `make push-snapshot`.
DAYTONA_SNAPSHOT=claude-playwright:1

# --- Database (Postgres / Supabase) --------------------------------------
# Local dev: docker-compose ships a postgres:16 container.
#   make pg-up  starts it on host port 5433 (override via POSTGRES_HOST_PORT).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hetchy?sslmode=disable
#
# Cloud (Supabase) — three connection modes from Project Settings → Database:
#   - Direct (port 5432):           full Postgres, prepared statements OK.
#                                   Use this for migrations.
#   - Session pooler (5432, *-pooler.supabase.com):
#                                   prepared statements OK.
#   - Transaction pooler (6543):    serverless-friendly, prepared statements
#                                   NOT supported — append
#                                   `?default_query_exec_mode=exec` for pgx.
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require

# --- Web UI --------------------------------------------------------------
# Port the local chat UI listens on (http://localhost:$WEB_PORT). Default
# is 8080 — avoid 3000, which the local Daytona dashboard uses.
WEB_PORT=8080

# --- Auth bypass (TESTS / CI ONLY) ---------------------------------------
# Setting AUTH_BYPASS=1 short-circuits WorkOS so go test / CI don't need
# real WorkOS credentials. Never enable in production.
# AUTH_BYPASS=1
# AUTH_BYPASS_USER=user_test
# AUTH_BYPASS_ORG=org_test
# AUTH_BYPASS_ROLE=admin
# AUTH_BYPASS_EMAIL=test@hetchy.local
