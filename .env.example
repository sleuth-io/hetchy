# REFERENCE ONLY - DO NOT copy to .env
# This project uses Doppler for configuration management.
# These values should be configured in Doppler, not in .env files.
# See README.md for setup instructions.

# --- Slack ---------------------------------------------------------------
# Bot User OAuth Token (xoxb-...) and App-Level Socket Mode Token (xapp-...).
SLACK_BOT_OAUTH_TOKEN=xoxb-...
SLACK_SOCKET_TOKEN=xapp-...

# --- Anthropic -----------------------------------------------------------
# Forwarded into each sandbox so Claude Code can run inside.
ANTHROPIC_API_KEY=sk-ant-...

# --- GitHub --------------------------------------------------------------
# A token with repo scope. The sandbox uses it to clone, push, and open PRs
# via the gh CLI. GITHUB_REPO is "owner/repo".
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo
GITHUB_BASE_BRANCH=main

# --- Daytona -------------------------------------------------------------
# Local OSS stack (after `make daytona-up` and creating an API key in the
# dashboard at http://localhost:3000):
DAYTONA_API_URL=http://localhost:3000/api
DAYTONA_API_KEY=dtn_...

# Hosted (Daytona Cloud) — swap the two values above for these:
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_API_KEY=dtn_...

# Snapshot to spawn from. Defaults to ghcr.io/$GITHUB_REPO/sandbox:latest.
# Build + push a local one with `make push-snapshot`.
DAYTONA_SNAPSHOT=claude-playwright:1

# --- Database (Postgres / Supabase) -------------------------------------
# Local dev: docker-compose ships a postgres:16 container.
#   make pg-up  starts it on host port 5433 (override via POSTGRES_HOST_PORT).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hetchy?sslmode=disable
#
# Cloud (Supabase) — three connection modes from Project Settings → Database:
#   - Direct (port 5432):           full Postgres, prepared statements OK.
#                                   Use this for migrations.
#   - Session pooler (5432, *-pooler.supabase.com):
#                                   prepared statements OK.
#   - Transaction pooler (6543):    serverless-friendly, prepared statements
#                                   NOT supported — append
#                                   `?default_query_exec_mode=exec` for pgx.
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require

# --- Web UI --------------------------------------------------------------
# Port the local chat UI listens on (http://localhost:$WEB_PORT). Default
# is 8080 — avoid 3000, which the local Daytona dashboard uses.
WEB_PORT=8080
