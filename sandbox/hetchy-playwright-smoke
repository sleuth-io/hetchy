#!/bin/bash
# Smoke-test the sandbox-provided Playwright package, Chromium binary,
# and the playwright-cli wrapper. Agents drive the browser through
# playwright-cli for validation; this script proves both that path and
# the underlying Playwright runtime are ready.

set -euo pipefail

export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-/opt/ms-playwright}"
if command -v npm >/dev/null 2>&1; then
  global_node_modules="$(npm root -g 2>/dev/null || true)"
  if [[ -n "$global_node_modules" ]]; then
    # Keep this NODE_PATH setup in sync with ensure_playwright_runtime
    # in internal/bot/scripts/sandbox-common.sh and BootstrapScript
    # in internal/bootstrap/loop.go.
    case ":${NODE_PATH:-}:" in
      *":${global_node_modules}:"*) ;;
      *)
        if [[ -n "${NODE_PATH:-}" ]]; then
          export NODE_PATH="${global_node_modules}:${NODE_PATH}"
        else
          export NODE_PATH="${global_node_modules}"
        fi
        ;;
    esac
  fi
fi

work_dir="${1:-/tmp/hetchy-playwright-smoke}"
mkdir -p "$work_dir"

cat > "${work_dir}/smoke.cjs" <<'NODE'
const { chromium } = require('playwright');

(async () => {
  const browser = await chromium.launch({
    headless: true,
    args: ['--no-sandbox'],
  });
  const page = await browser.newPage({ viewport: { width: 800, height: 600 } });
  await page.goto('about:blank');
  await page.screenshot({
    path: process.env.HETCHY_PLAYWRIGHT_SMOKE_SCREENSHOT || '/tmp/hetchy-playwright-smoke/about-blank.png',
  });
  await browser.close();
})().catch((err) => {
  console.error(err);
  process.exit(1);
});
NODE

node "${work_dir}/smoke.cjs"
printf 'Playwright smoke passed: %s\n' "${PLAYWRIGHT_BROWSERS_PATH}"

# playwright-cli smoke: prove the bundled CLI binary launches its
# browser, navigates somewhere, and exits cleanly. Pin the user-data
# and output dirs under the work_dir so we don't pollute the daytona
# user's home or cwd from a build/CI run.
export PLAYWRIGHT_MCP_USER_DATA_DIR="${PLAYWRIGHT_MCP_USER_DATA_DIR:-${work_dir}/cli-user-data}"
export PLAYWRIGHT_MCP_OUTPUT_DIR="${PLAYWRIGHT_MCP_OUTPUT_DIR:-${work_dir}/cli-output}"
mkdir -p "$PLAYWRIGHT_MCP_USER_DATA_DIR" "$PLAYWRIGHT_MCP_OUTPUT_DIR"
playwright-cli --version
playwright-cli open about:blank
playwright-cli close
printf 'playwright-cli smoke passed: %s\n' "$(playwright-cli --version)"
